{
  "name": "@hpe/runtime-browser",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./keyboard": {
      "types": "./dist/keyboard.d.ts",
      "import": "./dist/keyboard.js"
    },
    "./fullscreen": {
      "types": "./dist/fullscreen.d.ts",
      "import": "./dist/fullscreen.js"
    },
    "./touch": {
      "types": "./dist/touch.d.ts",
      "import": "./dist/touch.js"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./presentation-sync": {
      "types": "./dist/presentation-sync.d.ts",
      "import": "./dist/presentation-sync.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@hpe/runtime-core": "0.1.0"
  }
}
