{
  "name": "@hpe/compiler",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Vue SFC compiler and Vite adapter for HPE decks",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wudixzy114/HPE.git",
    "directory": "packages/compiler"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "import": "./dist/highlight.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/types": "7.29.7",
    "@hpe/schema": "0.1.0",
    "@vue/compiler-core": "3.5.40",
    "@vue/compiler-dom": "3.5.40",
    "@vue/compiler-sfc": "3.5.40",
    "shiki": "4.3.1",
    "vite": "8.2.0"
  }
}
