{
  "name": "@hpe/runtime-core",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-neutral state, timeline and inspectable-state ports for HPE",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wudixzy114/HPE.git",
    "directory": "packages/runtime-core"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./slide-state": {
      "types": "./dist/slide-state.d.ts",
      "import": "./dist/slide-state.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@hpe/schema": "0.1.0"
  }
}
