{
  "name": "hpe",
  "version": "0.1.0",
  "private": true,
  "description": "A modular, AI-friendly HTML presentation engine",
  "license": "UNLICENSED",
  "repository": "github:wudixzy114/HPE",
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "build": "npm run build:packages && node scripts/run-deck.mjs build",
    "build:packages": "tsc -b && npm run assets -w @hpe/schema && npm run bin:chmod -w @hpe/cli",
    "boundaries": "dependency-cruiser packages/*/src app/src app/slides app/themes --config .dependency-cruiser.cjs",
    "check": "npm run format:check && npm run lint && npm run boundaries && npm run typecheck && npm test && npm run build",
    "clean": "rimraf packages/*/dist packages/*/*.tsbuildinfo app/dist app/*.tsbuildinfo coverage artifacts",
    "dev": "node scripts/run-deck.mjs dev --deck-root ./presentations/database-design",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "postinstall": "playwright install chromium",
    "preview": "node scripts/run-deck.mjs preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:isolation": "node scripts/verify-deck-isolation.mjs",
    "test:bundle": "npm run build && node scripts/verify-bundle.mjs",
    "test:licenses": "node scripts/verify-licenses.mjs",
    "test:packages": "npm run build:packages && node scripts/verify-packages.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && npm run typecheck -w @hpe/app",
    "verify": "npm run check && npm run test:coverage && npm run test:packages && npm run test:bundle && npm run test:isolation && npm run test:e2e && npm run test:licenses && npm audit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
