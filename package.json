{
  "name": "hpe",
  "version": "0.1.0",
  "private": true,
  "description": "A modular, AI-friendly HTML presentation engine",
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @hpe/app",
    "build:packages": "tsc -b",
    "boundaries": "dependency-cruiser packages/*/src app/src --config .dependency-cruiser.cjs",
    "check": "npm run format:check && npm run lint && npm run boundaries && npm run typecheck && npm test && npm run build",
    "clean": "rimraf packages/*/dist packages/*/*.tsbuildinfo app/dist app/*.tsbuildinfo coverage artifacts",
    "dev": "npm run dev -w @hpe/app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "postinstall": "playwright install chromium",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b && npm run typecheck -w @hpe/app"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
