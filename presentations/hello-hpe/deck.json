{
  "$schema": "../../packages/schema/src/deck.schema.json",
  "schemaVersion": 1,
  "id": "hello-hpe",
  "title": "Hello HPE",
  "size": {
    "width": 1600,
    "height": 900
  },
  "theme": {
    "entry": "themes/hpe-minimal/theme.ts"
  },
  "slides": [
    {
      "id": "cover",
      "file": "slides/cover.slide.vue",
      "title": "Hello HPE"
    },
    {
      "id": "steps",
      "file": "slides/steps.slide.vue",
      "title": "Steps reveal content progressively",
      "maxStep": 2
    },
    {
      "id": "interaction",
      "file": "slides/interaction.slide.vue",
      "title": "Inspectable interaction with useSlideState"
    },
    {
      "id": "code",
      "file": "slides/code.slide.vue",
      "title": "Static syntax highlighting with ShikiCode",
      "maxStep": 1
    }
  ]
}
