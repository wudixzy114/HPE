erDiagram
    direction LR

    task_template ||--o{ task : "创建任务"
    task ||--|{ task_input : "拥有输入"
    task ||--|{ task_run : "产生尝试"

    task_template {
        bigint id PK
        varchar name
        varchar state "状态受控"
    }
    task {
        bigint id PK
        bigint template_id FK
        bigint user_id "外部引用"
        bigint project_id "外部引用"
        varchar name
        smallint priority
        datetime created_at
        varchar request_key "与 project_id 联合唯一"
        varchar current_status "当前快照"
    }
    task_input {
        bigint id PK
        bigint task_id FK
        bigint source_id "外部引用"
        int input_no "与 task_id 联合唯一"
        varchar input_role
    }
    task_run {
        bigint id PK
        bigint task_id FK
        int attempt_no "与 task_id 联合唯一"
        varchar status
        datetime started_at
        datetime finished_at
        text error_message
    }
